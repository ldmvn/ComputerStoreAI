JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=2h
DATABASE_URL=mysql://user:password@localhost:3306/computerstoreai
PORT=5000
# Must be "production" on the real server. Google OAuth (src/config/
# googleOAuth.js) refuses to run over plain HTTP only when this is exactly
# "production" — leaving it unset/"development" in production silently skips
# that check.
NODE_ENV=development
# List every origin the frontend is actually served from, comma-separated.
# This is also the allowlist Google OAuth redirects back into (see
# src/config/googleOAuth.js) — a request through https://ducmanh.store only
# ever comes back to https://ducmanh.store, and localhost only to localhost,
# because both must already be listed here. Add the real production origin
# alongside localhost rather than replacing it, e.g.:
#   CORS_ORIGIN=http://localhost:3000,https://ducmanh.store
CORS_ORIGIN=http://localhost:3000
# Optional: pins the Google OAuth redirect to exactly one frontend origin
# instead of inferring it from CORS_ORIGIN per-request. Leave unset unless
# you deploy a single fixed frontend and want to skip the inference.
# FRONTEND_URL=https://ducmanh.store
# Fill these in backend/.env only. Never expose the secret to the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the backend's own PUBLIC origin + /api/auth/google/callback, and
# must exactly match an "Authorized redirect URI" in Google Cloud Console.
# Production: https://ducmanh.store/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Gmail SMTP: fill in your own mailbox and Google App Password in backend/.env.
# Never put a real App Password in this template or source code.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DUCMANHPC <your-address@gmail.com>"
# Optional independent secret; defaults to JWT_SECRET. Use a long random value.
PASSWORD_RESET_SECRET=
# Optional: defaults to backend/uploads; persist this directory in deployments.
# MEDIA_STORAGE_DIR=/absolute/path/to/media
# Optional public origin/path for local media, or your CDN URL.
# MEDIA_PUBLIC_URL=https://api.example.com/media
# Max saved build configs per IP per hour (default 60). Resets on server restart.
# BUILD_SAVE_RATE_LIMIT_PER_HOUR=60
# Trust proxy hops behind a reverse proxy (nginx, Docker, load balancer).
# Set =1 for one hop (most common). Leave empty when running directly.
# TRUST_PROXY=1

# ── AI Foundation (backend/src/ai/) — all optional, all off by default ──────
# Set all three to enable the AI shopping assistant chatbot.
# AI_ENABLED=true
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_CHAT_MAX_LENGTH=2000
# AI_CHAT_RATE_LIMIT_PER_HOUR=60
# AI_PROVIDER_TIMEOUT_MS=30000
# RAG_ENABLED=true
# VECTOR_STORE_PROVIDER=json  # json | qdrant | memory
# EMBEDDING_PROVIDER=gemini   # gemini | openai
# EMBEDDING_MODEL=gemini-embedding-001

# ── SePay VietQR auto-confirmation (backend/src/payments/) ──────────────────
# Secret Key from SePay's webhook "Security" step (HMAC-SHA256, recommended).
# SePay signs each webhook: header X-SePay-Signature: sha256=<hex> over the
# raw body `${X-SePay-Timestamp}.${rawBody}`. Store the real value in .env only.
# Webhook URL to register in SePay: https://<your-domain>/api/payments/sepay/webhook
# SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_here

# ── VNPAY (Sandbox) ────────────────────────────────────────────────────────────
# IMPORTANT: VNPAY does not accept an IPN URL in the signed `pay` request.
# VNPAY_IPN_URL is an operational record/check only; register this exact URL
# in the VNPAY merchant dashboard (Website/Application -> IPN URL).
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=https://ducmanh.store/payment/vnpay/return
# VNPAY_IPN_URL=https://ducmanh.store/api/payments/vnpay/ipn

# ── MoMo (Sandbox v2 — /v2/gateway/api/create) ──────────────────────────────
# Reuse the sandbox keys from MoMo's developer dashboard. orderId/requestId are
# namespaced (DMPC<orderId>T<ms>) so they never collide with another site's
# transactions under the SAME shared sandbox keys.
# Register these exact public URLs in your MoMo app config:
#   Redirect (IPN) URL: https://ducmanh.store/api/payments/momo/ipn
#   Return URL:         https://ducmanh.store/payment/momo/return
# MOMO_PARTNER_CODE=MOMO
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# MOMO_REDIRECT_URL=https://ducmanh.store/payment/momo/return
# MOMO_IPN_URL=https://ducmanh.store/api/payments/momo/ipn
# Provider Query abuse protection (authenticated reconcile endpoint, per user)
PAYMENT_RECONCILE_RATE_LIMIT_PER_MINUTE=10
# Phase 3: query embedding timeout; failure falls back to BM25 (milliseconds)
RAG_QUERY_EMBEDDING_TIMEOUT_MS=4000
