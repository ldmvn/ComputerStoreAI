{
  "name": "computerstoreai-backend",
  "version": "1.0.0",
  "description": "Backend API for ComputerStoreAI - E-commerce platform for PCs and Laptops",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test:rag:multiturn": "node --test tests/unit/productContext.test.mjs tests/multiturnRag.http.mjs",
    "test:rag:phase3": "node --test tests/unit/ragPhase3.test.mjs tests/unit/ragSync.test.mjs tests/unit/ragChatFlow.test.mjs tests/unit/aiFoundation.test.mjs tests/unit/aiChatService.test.mjs tests/unit/geminiProvider.test.mjs",
    "benchmark:rag:phase3": "node tests/evaluation/phase3.benchmark.mjs",
    "rag:health": "node scripts/rag-index-health.mjs",
    "test:product-detail": "node tests/productDetail.integration.mjs",
    "test:attributes": "node tests/attribute.integration.mjs",
    "test:specification-sources": "node tests/productSpecificationSources.integration.mjs",
    "test:brand-filter": "node tests/brandFilter.integration.mjs",
    "brands:normalize-slugs": "node scripts/normalize-brand-slugs.mjs",
    "test:mega-menu": "node --test tests/unit/megaMenu.validator.test.mjs && node tests/megaMenu.integration.mjs",
    "test:google-auth": "node tests/googleAuth.integration.mjs",
    "test:password-reset": "node tests/passwordReset.integration.mjs && node --test tests/passwordReset.lifecycle.mjs tests/unit/smtpEnv.test.mjs",
    "test:password-reset:gmail": "node tests/gmailReset.integration.mjs",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test:banners": "node tests/banner.integration.mjs",
    "test:categories": "node --test tests/unit/category.validator.test.mjs",
    "test:brands": "node --test tests/unit/brand.validator.test.mjs",
    "test:support-widget": "node --test tests/unit/supportWidget.validator.test.mjs",
    "test:ai": "node --test tests/unit/aiFoundation.test.mjs && node tests/ai.integration.mjs",
    "test:payment-status": "node --test tests/unit/paymentStatus.validator.test.mjs tests/unit/paymentConfirmation.concurrency.test.mjs",
    "test:payment-integration": "node tests/payment.integration.mjs",
    "test:payment-flow": "node tests/paymentFlow.integration.mjs",
    "test:payment-e2e": "node tests/e2e/paymentFlow.playwright.mjs",
    "test:admin-orders-merge-e2e": "node tests/e2e/adminOrdersMerge.playwright.mjs",
    "test:payment-sync-e2e": "node tests/e2e/paymentSync.playwright.mjs",
    "test:payment-approval-guard": "node tests/paymentApprovalGuard.integration.mjs",
    "test:sepay": "node --test tests/unit/sepayUtil.test.mjs && node tests/sepay.integration.mjs",
    "test:momo": "node --test tests/unit/momoUtil.test.mjs && node tests/momo.integration.mjs",
    "test:momo-e2e": "node tests/e2e/momoFlow.playwright.mjs",
    "test:domain-migration-e2e": "node tests/e2e/domainMigration.playwright.mjs",
    "test:vnpay-util": "node --test tests/unit/vnpayUtil.test.mjs",
    "test:vnpay-integration": "node tests/vnpay.integration.mjs",
    "test:vnpay-e2e": "node tests/e2e/vnpayFlow.playwright.mjs",
    "test:reconcile": "node tests/paymentReconcile.integration.mjs",
    "test:payment-late-ipn-domain": "node tests/e2e/paymentLateIpn.domain.mjs",
    "test:categories:integration": "node tests/category.integration.mjs",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "seed:build-pc": "node src/scripts/seedBuildPc.js",
    "seed:build-pc-products": "node src/scripts/seedBuildPcProducts.js",
    "seed:build-pc-admin-data": "node src/scripts/seedBuildPcAdminData.js",
    "fix:build-pc-specs": "node src/scripts/applyBuildPcSpecFixes.js",
    "fix:seed-product-normalization": "node src/scripts/normalizeSeedProducts.js",
    "ai:descriptions": "node scripts/generate-descriptions.mjs",
    "ai:descriptions:dry": "node scripts/generate-descriptions.mjs --dry-run",
    "ai:descriptions:limit": "node scripts/generate-descriptions.mjs --limit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "file-type": "^20.5.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
